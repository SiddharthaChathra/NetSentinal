# --- Supabase -------------------------------------------------------------
SUPABASE_URL=

# The SERVER-SIDE key: Settings -> API Keys -> service_role / secret.
#
# It must be the service-role key, not the publishable one. The backend scopes
# every query by the account it resolved from the session, so it needs a key
# that bypasses Row-Level Security. With the publishable key, RLS denies every
# per-user read and write and devices, history and incidents silently stay
# empty with no error anywhere.
#
# /api/health reports which one is in use as `database_access`.
# This key must NEVER reach the frontend or be committed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ----------------------------------------------------------
API_BASE_URL=http://localhost:8000

# Optional. A legacy admin-wide agent token that is not tied to any account.
# Leave it empty: each account now gets its own `nsa_` token, issued through
# the website and handed to a machine with a short-lived enrolment code.
AGENT_TOKEN=

# --- Optional overrides ---------------------------------------------------
# Force the login gate on or off. Unset means "on whenever a database is
# configured", which is what production wants.
# AUTH_REQUIRED=1

# Re-expose /docs, /redoc and /openapi.json, which the login gate closes.
# EXPOSE_API_DOCS=1
